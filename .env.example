# Copy to .env (never commit it) and adjust. Used by docker compose.

# REQUIRED. 32 random bytes as 64 hex characters: openssl rand -hex 32
# This key encrypts every project's data key. Back it up separately from the database.
SV_MASTER_KEY=

# Database password used by the bundled PostgreSQL service (change it!)
POSTGRES_PASSWORD=change-me

# Host port for the web app and API
SV_PORT=8080

# Set to false after your team has signed up to close public registration
SV_ALLOW_REGISTRATION=true

# Optional: email for sign-in codes (two-step verification backup). Leave empty to disable email.
# SV_SMTP_URL=smtps://user:password@smtp.example.com:465
# SV_MAIL_FROM=SecretVariable <no-reply@example.com>

# Optional tuning (see guide/self-hosting.md)
# SV_SESSION_TTL_DAYS=30
# SV_AUTH_RATE_LIMIT=20
# SV_LOG=true
