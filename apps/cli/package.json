{
  "name": "@secretvariable/cli",
  "version": "0.0.0",
  "private": false,
  "description": "Command-line tool to pull, push and run .env files stored in SecretVariable",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@secretvariable/shared": "workspace:*"
  },
  "devDependencies": {
    "@secretvariable/crypto": "workspace:*",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "bin": {
    "secretvariable": "dist/index.js"
  },
  "files": [
    "dist"
  ]
}
